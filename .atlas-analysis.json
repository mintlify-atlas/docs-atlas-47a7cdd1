  "projectType": "sdk-library",
  "projectName": "Rust-GPU",
  "projectDescription": "A compiler backend and standard library that enables writing GPU shaders in Rust, compiling them to SPIR-V for use with Vulkan, wgpu, and other graphics APIs.",
