  "keyFeatures": [
    "Write GPU shaders entirely in Rust with full language support",
    "Compiles Rust to SPIR-V via a custom rustc codegen backend",
    "spirv-std provides a no_std shader standard library with image, sampler, and math types",
    "spirv-builder crate automates shader compilation from build scripts",
    "Supports Vulkan, wgpu, WebGPU, OpenCL, and raw SPIR-V targets",
    "Inline SPIR-V assembly support via Rust's asm! macro",
    "Ray tracing support via AccelerationStructure and related types",
    "Specialization constants, workgroup shared memory, and descriptor set binding attributes",
    "SPIR-T IR framework for robust structurization and optimization",
    "Panic handling strategies including debugPrintf-based reporting"
  ],
  "publicApiSurface": [
    "spirv_builder::SpirvBuilder",
    "spirv_builder::SpirvBuilder::new(path_to_crate, target)",
    "spirv_builder::SpirvBuilder::build()",
