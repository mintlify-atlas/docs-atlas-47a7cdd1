    "spirv_builder::MetadataPrintout",
    "spirv_builder::SpirvMetadata",
    "spirv_builder::ShaderPanicStrategy",
    "spirv_std::spirv (proc macro attribute)",
    "#[spirv(fragment)], #[spirv(vertex)], #[spirv(compute(threads(...)))]",
    "#[spirv(position)], #[spirv(vertex_id)], and other builtin attributes",
    "#[spirv(descriptor_set = N, binding = N)]",
    "#[spirv(workgroup)]",
